# Base URL of the Spring Boot API.
#
# Local development: point straight at the backend (CORS handles the cross-origin
# call, and the backend allows http://localhost:5173 out of the box).
#
#   VITE_API_BASE_URL=http://localhost:8080/api
#
# Production: use the deployed API origin.
#   VITE_API_BASE_URL=https://your-api.onrender.com/api
#
# Leave it UNSET to fall back to "/api" and let the Vite dev proxy forward to
# http://localhost:8080 (see vite.config.js).
VITE_API_BASE_URL=http://localhost:8080/api
