# -----------------------------------------------------------------------------
# Backend environment. Copy to .env and fill in. Never commit the real .env.
# Every value below is read by src/main/resources/application.properties.
# -----------------------------------------------------------------------------

# --- REQUIRED: database ------------------------------------------------------
# Either these three...
SPRING_DATASOURCE_URL=jdbc:postgresql://user:password@host:5432/dbname
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me
# ...or a single URL, which the app parses for you. This is what Render, Railway,
# Heroku and Fly inject automatically for their Postgres add-ons:
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- REQUIRED: email (Brevo) --------------------------------------------------
# Brevo -> Settings -> SMTP & API -> SMTP
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your-brevo-smtp-login          # NOT your Brevo account email
MAIL_PASSWORD=your-brevo-smtp-key            # the generated SMTP key, not your account password

# Must be a sender address you have VERIFIED in Brevo
# (Senders & Domains -> Email). Unverified senders are silently dropped - this is
# the number one reason no email arrives during setup.
MAIL_FROM_EMAIL=no-reply@yourdomain.com
MAIL_FROM_NAME=DSA Viz

# Your deployed frontend origin, used for the link inside the email.
APP_URL=http://localhost:5173

# --- REQUIRED: JWT signing secret --------------------------------------------
# Generate with:  openssl rand -base64 48
# Startup fails loudly if this is missing or shorter than 32 bytes.
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# --- CORS --------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- OPTIONAL ---------------------------------------------------------------
# Defaults to JWT_SECRET. Set to rotate OTP hashing independently; changing it
# invalidates every code currently outstanding.
OTP_PEPPER=

# Codes expire after this many minutes, and are burned after this many wrong guesses.
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Minimum gap between two sends to the same address, and per-hour ceilings per
# address and per client IP. The defaults are deliberately tight: Brevo's free
# tier allows 300 emails/day, and a limit breach gets the account suspended.
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR_PER_EMAIL=5
OTP_MAX_PER_HOUR_PER_IP=20

# Cloudinary avatar uploads. Leave blank to boot without it.
CLOUDINARY_URL=
